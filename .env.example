# Copy to .env and fill in. Never commit .env: RPC URLs usually contain an API key.

# base-sepolia (default) or base
NETWORK=base-sepolia
# One or more JSON-RPC URLs, comma-separated. The indexer fails over between them.
# The public endpoint works for a demo but is limited to 25 requests/s and 200-block log queries.
RPC_URLS=https://sepolia.base.org
# Addresses whose incoming and outgoing USDC transfers are indexed, comma-separated
WATCH_ADDRESSES=0x2e78bcdcbf7ba1adc2252819d6134d6549960f3a,0xa849bbad82f9edafdf9a5550cc874276138779d9

# Used when running the binary directly (docker compose sets its own)
DATABASE_URL=postgres://postgres:postgres@localhost:5440/indexer?sslmode=disable

# Optional (defaults shown)
# START_BLOCK=0                  # 0 = the finalized block at first start-up
# CONFIRM_AT=finalized           # pending | safe | finalized: when transfer.confirmed is emitted
# MAX_BLOCK_RANGE=2000           # eth_getLogs range; shrinks automatically if the node refuses
# MAX_UNFINALIZED_BATCH=100      # unfinalized blocks per step
# POLL_INTERVAL=2s
# RECONCILE_INTERVAL=5m          # 0 disables balanceOf reconciliation
# RPC_MAX_RPS=10                 # client-side limit; batch elements count individually
# RPC_MAX_ATTEMPTS=5
# RPC_TIMEOUT=15s
# HTTP_ADDR=:8080
# LOG_LEVEL=info
# LOG_FORMAT=json                # json | text

# Publish outbox events to an SQS FIFO queue (see github.com/BrianLiu0531/usdc-deposit-ledger).
# Unset = events are written to the log. Uses the standard AWS credential chain and AWS_REGION.
# OUTBOX_SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/usdc-transfers.fifo
